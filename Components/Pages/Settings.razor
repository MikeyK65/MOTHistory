@page "/settings"
@rendermode InteractiveServer
@inject DVSASettingsService SettingsService

<PageTitle>Settings</PageTitle>

<section class="page-header">
    <h1>DVSA API Settings</h1>
    <p class="page-subtitle">Credentials used to call the DVSA MOT History API. Stored locally on this machine, outside the application folder.</p>
</section>

<EditForm Model="model" OnSubmit="Save" class="card settings-form">
    <fieldset class="form-section">
        <legend>Credentials</legend>

        <div class="form-field">
            <label for="apiKey" class="form-label">API key</label>
            <div class="input-group">
                <input id="apiKey" type="@(showApiKey ? "text" : "password")" class="input" @bind="model.ApiKey" autocomplete="off" />
                <button type="button" class="input-group-btn" @onclick="() => showApiKey = !showApiKey">@(showApiKey ? "Hide" : "Show")</button>
            </div>
        </div>

        <div class="form-field">
            <label for="clientId" class="form-label">Client ID</label>
            <input id="clientId" class="input" @bind="model.ClientId" autocomplete="off" />
        </div>

        <div class="form-field">
            <label for="clientSecret" class="form-label">Client secret</label>
            <div class="input-group">
                <input id="clientSecret" type="@(showClientSecret ? "text" : "password")" class="input" @bind="model.ClientSecret" autocomplete="off" />
                <button type="button" class="input-group-btn" @onclick="() => showClientSecret = !showClientSecret">@(showClientSecret ? "Hide" : "Show")</button>
            </div>
        </div>
    </fieldset>

    <fieldset class="form-section">
        <legend>Endpoints</legend>

        <div class="form-field">
            <label for="baseUrl" class="form-label">Base URL</label>
            <input id="baseUrl" class="input" @bind="model.BaseUrl" placeholder="https://history.mot.api.gov.uk" />
            <p class="form-help">The DVSA MOT History API base address.</p>
        </div>

        <div class="form-field">
            <label for="scopeUrl" class="form-label">Scope URL</label>
            <input id="scopeUrl" class="input" @bind="model.ScopeUrl" placeholder="https://tapi.dvsa.gov.uk/.default" />
            <p class="form-help">OAuth2 scope requested for the access token.</p>
        </div>

        <div class="form-field">
            <label for="tokenUrl" class="form-label">Token URL</label>
            <input id="tokenUrl" class="input" @bind="model.TokenUrl" placeholder="https://login.microsoftonline.com/{tenant}/oauth2/v2.0/token" />
            <p class="form-help">Token endpoint used for the client-credentials grant.</p>
        </div>
    </fieldset>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save settings</button>
        <a href="/" class="btn btn-ghost">Back to MOT history checker</a>
    </div>
</EditForm>

@if (saved)
{
    <div class="alert alert-success" role="status">Settings saved.</div>
}

@code {
    private DVSASettings model = new();
    private bool saved;
    private bool showApiKey;
    private bool showClientSecret;

    protected override void OnInitialized()
    {
        model = SettingsService.Current;
    }

    private void Save()
    {
        SettingsService.Save(model);
        saved = true;
    }
}
