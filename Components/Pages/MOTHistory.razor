@using System.Text.Json
@* global:: is required here — this component's own class name (MOTHistory) shadows the
   MOTHistory namespace root, so an unqualified "MOTHistory.Shared" resolves to the type. *@
@using global::MOTHistory.Shared

@page "/"
@rendermode InteractiveServer
@inject DVSAApiService MotService
@inject DVLAApiService DvlaService

<PageTitle>MOT History Checker</PageTitle>

<section class="page-header">
    <h1>MOT History Checker</h1>
    <p class="page-subtitle">Look up the full MOT test history for any UK-registered vehicle.</p>
</section>

<section class="card search-card">
    <form class="search-bar" @onsubmit="CheckMotHistory">
        <div class="form-field search-field">
            <label for="regInput" class="form-label">Vehicle registration</label>
            <input id="regInput" @bind="registration" class="input plate-input" placeholder="e.g. AB12 CDE" autocomplete="off" />
        </div>
        <button type="submit" class="btn btn-primary" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner" aria-hidden="true"></span>
                <span>Checking…</span>
            }
            else
            {
                <span>Check history</span>
            }
        </button>
    </form>
</section>

@if (error != null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (hasRecall)
{
    <div class="alert alert-danger" role="alert">
        <strong>Outstanding safety recall.</strong>
        DVSA records an unresolved manufacturer recall for this vehicle. Contact a franchised
        dealer — recall work is carried out free of charge.
    </div>
}

@if (mileageReport.HasAnomalies)
{
    <div class="alert @(mileageReport.HasRollback ? "alert-danger" : "alert-warning")" role="alert">
        <strong>@(mileageReport.HasRollback ? "Mileage discrepancy." : "Unusual mileage.")</strong>
        @if (mileageReport.HasRollback)
        {
            <span>
                The recorded odometer reading goes down between tests. This can indicate a replaced
                instrument cluster, a recording error, or that the vehicle has been clocked.
            </span>
        }
        else
        {
            <span>The mileage recorded between tests is unusually high for the time elapsed.</span>
        }
        <ul class="anomaly-list">
            @foreach (var anomaly in mileageReport.Anomalies)
            {
                <li>@anomaly.Description</li>
            }
        </ul>
    </div>
}

@if (taxInfo is not null)
{
    var ved = VedCalculator.Estimate(taxInfo);
    var ulez = UlezChecker.Check(taxInfo);

    <section class="card vehicle-facts">
        <h2 class="facts-title">Tax &amp; emissions</h2>

        <div class="fact-row">
            <span class="fact-label">Tax status</span>
            <span class="fact-value">
                <span class="badge @TaxBadgeClass(taxInfo)">@taxInfo.TaxStatusDisplay</span>
                @if (taxInfo.TaxDueDate is not null)
                {
                    <span class="fact-sub @(taxInfo.IsTaxOverdue ? "fact-sub-danger" : taxInfo.IsTaxDueSoon ? "fact-sub-warning" : "")">
                        @taxInfo.TaxDueDisplay
                    </span>
                }
            </span>
        </div>

        @if (ved.HasRate)
        {
            <div class="fact-row">
                <span class="fact-label">Estimated road tax</span>
                <span class="fact-value">
                    @ved.RateDisplay/yr
                    @if (ved.Band is not null)
                    {
                        <span class="fact-sub">@ved.Band</span>
                    }
                </span>
            </div>
            <p class="fact-note">
                @ved.Basis. @VedCalculator.RateTableTaxYear rates — verify at
                <a href="https://www.gov.uk/vehicle-tax-rate-tables" target="_blank" rel="noopener">gov.uk</a>.
                @ved.Caveat
            </p>
        }

        @if (!string.IsNullOrEmpty(taxInfo.Co2Display) || !string.IsNullOrEmpty(taxInfo.EuroStatusDisplay))
        {
            <div class="fact-row">
                <span class="fact-label">Emissions</span>
                <span class="fact-value">
                    @string.Join(" · ", new[] { taxInfo.Co2Display, taxInfo.EuroStatusDisplay }.Where(s => !string.IsNullOrEmpty(s)))
                </span>
            </div>
        }

        @if (ulez.Verdict != UlezVerdict.Unknown)
        {
            <div class="fact-row">
                <span class="fact-label">ULEZ</span>
                <span class="fact-value @(ulez.Verdict == UlezVerdict.Compliant ? "fact-value-good" : "fact-value-bad")">
                    @ulez.VerdictDisplay
                </span>
            </div>
            <p class="fact-note">
                @ulez.Reason Estimate only — confirm at
                <a href="https://tfl.gov.uk/modes/driving/check-your-vehicle" target="_blank" rel="noopener">tfl.gov.uk</a>.
            </p>
        }

        @if (taxInfo.MarkedForExport)
        {
            <div class="fact-row">
                <span class="fact-label">Export marker</span>
                <span class="fact-value fact-value-bad">Marked for export</span>
            </div>
        }

        @if (taxInfo.V5CRecentlyIssued)
        {
            <div class="fact-row">
                <span class="fact-label">Last V5C issued</span>
                <span class="fact-value">@taxInfo.DateOfLastV5CIssued!.Value.ToString("d MMM yyyy")</span>
            </div>
            <p class="fact-note">A recently issued logbook often means the vehicle has changed keeper.</p>
        }
    </section>
}
else if (taxError is not null)
{
    <div class="alert alert-warning" role="alert">@taxError</div>
}

@if (motTests != null)
{
    @if (motTests.Count == 0)
    {
        <div class="empty-state">No MOT tests found for this vehicle.</div>
    }
    else
    {
        <section class="results">
            <div class="results-header">
                <h2>Results for <span class="plate-chip">@registration</span></h2>
                <span class="results-count">@motTests.Count test@(motTests.Count == 1 ? "" : "s")</span>
            </div>
            @if (mileageReport.AverageAnnualDisplay is { } averageMileage)
            {
                <p class="mileage-summary">
                    Averages <strong>@averageMileage</strong> — @mileageReport.UsageComparison of
                    @MileageAnalysis.UkAverageAnnualMiles.ToString("N0") miles/year.
                </p>
            }
            <ul class="timeline">
                @foreach (var test in motTests)
                {
                    var statusClass = StatusClass(test.TestResult);
                    <li class="timeline-item">
                        <div class="timeline-marker @statusClass"></div>
                        <div class="timeline-content card">
                            <div class="timeline-row">
                                <span class="timeline-date">@test.TestDate.ToString("d MMM yyyy")</span>
                                <span class="badge @statusClass">@test.TestResult</span>
                            </div>
                            <div class="timeline-meta">
                                <span>Odometer: <strong>@test.OdometerValue @test.OdometerUnit</strong></span>
                                @if (test.ExpiryDate is not null)
                                {
                                    <span>Expires: <strong>@test.ExpiryDate.Value.ToString("d MMM yyyy")</strong></span>
                                }
                            </div>
                            @if (test.Failures.Count > 0)
                            {
                                <div class="defect-group defect-fail">
                                    <h4>Failures</h4>
                                    <ul>
                                        @foreach (var f in test.Failures)
                                        {
                                            <li>@f</li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (test.Advisories.Count > 0)
                            {
                                <div class="defect-group defect-advisory">
                                    <h4>Advisories</h4>
                                    <ul>
                                        @foreach (var a in test.Advisories)
                                        {
                                            <li>@a</li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (test.Failures.Count == 0 && test.Advisories.Count == 0)
                            {
                                <p class="no-defects">No defects recorded.</p>
                            }
                        </div>
                    </li>
                }
            </ul>
        </section>
    }
}

@code {
    private string registration = string.Empty;
    private string? error;
    private bool isLoading = false;
    private List<MotTest>? motTests;

    private VehicleTaxInfo? taxInfo;
    private string? taxError;
    private bool hasRecall;
    private MileageReport mileageReport = MileageReport.Empty;

    private static string StatusClass(string result) =>
        result.Contains("PASS", StringComparison.OrdinalIgnoreCase) ? "status-pass" : "status-fail";

    private static string TaxBadgeClass(VehicleTaxInfo tax) =>
        tax.IsTaxed ? "status-pass" : tax.IsSorn ? "status-warning" : "status-fail";

    private async Task CheckMotHistory()
    {
        error = null;
        motTests = null;
        taxInfo = null;
        taxError = null;
        hasRecall = false;
        mileageReport = MileageReport.Empty;
        isLoading = true;
        try
        {
            // MOT history and DVLA tax data are independent lookups — run them together so
            // adding the second call doesn't slow the search down.
            var motTask = MotService.GetMotHistoryAsync(registration);
            var dvlaTask = DvlaService.GetVehicleAsync(registration);
            await Task.WhenAll(motTask, dvlaTask);

            var (json, apiError) = await motTask;
            var (dvlaJson, dvlaError) = await dvlaTask;

            taxError = dvlaError;
            if (dvlaJson is not null)
            {
                taxInfo = VehicleTaxInfo.Parse(dvlaJson.Value, NormaliseRegistration(registration));
            }

            if (apiError is not null)
            {
                error = apiError;
                return;
            }

            if (json is null)
            {
                error = "No MOT history found or API error.";
                return;
            }

            JsonElement vehicle;
            if (json.Value.ValueKind == JsonValueKind.Array)
            {
                if (json.Value.GetArrayLength() == 0)
                {
                    error = "No MOT history found.";
                    return;
                }
                vehicle = json.Value[0];
            }
            else
            {
                vehicle = json.Value;
            }

            // DVSA reports this as "Yes"/"No"/"Unknown"; accept a JSON boolean too in case
            // the representation changes.
            if (vehicle.TryGetProperty("hasOutstandingRecall", out var recall))
            {
                hasRecall = recall.ValueKind == JsonValueKind.True
                    || (recall.ValueKind == JsonValueKind.String
                        && string.Equals(recall.GetString(), "Yes", StringComparison.OrdinalIgnoreCase));
            }

            motTests = new List<MotTest>();
            if (vehicle.TryGetProperty("motTests", out var tests) && tests.ValueKind == JsonValueKind.Array)
            {
                foreach (var t in tests.EnumerateArray())
                {
                    var test = new MotTest
                    {
                        TestDate = t.TryGetProperty("completedDate", out var cd) ? cd.GetDateTime() : default,
                        TestResult = t.TryGetProperty("testResult", out var tr) ? (tr.GetString() ?? "") : "",
                        ExpiryDate = t.TryGetProperty("expiryDate", out var exp) && exp.ValueKind != JsonValueKind.Null ? exp.GetDateTime() : (DateTime?)null,
                        OdometerValue = t.TryGetProperty("odometerValue", out var odo) ? (odo.GetString() ?? "") : "",
                        OdometerUnit = t.TryGetProperty("odometerUnit", out var unit) ? (unit.GetString() ?? "") : "",
                        Failures = new List<string>(),
                        Advisories = new List<string>()
                    };

                    if (t.TryGetProperty("defects", out var defects) && defects.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var d in defects.EnumerateArray())
                        {
                            var type = d.TryGetProperty("type", out var dt) ? dt.GetString() : null;
                            var text = d.TryGetProperty("text", out var txt) ? txt.GetString() : null;
                            // DANGEROUS/MAJOR/FAIL (legacy) defects fail the test; MINOR/ADVISORY don't.
                            if (type is "FAIL" or "MAJOR" or "DANGEROUS") test.Failures.Add(text ?? "");
                            else if (type is "ADVISORY" or "MINOR") test.Advisories.Add(text ?? "");
                        }
                    }
                    motTests.Add(test);
                }

                mileageReport = MileageAnalysis.Analyse(
                    motTests
                        .Where(t => t.OdometerMiles > 0)
                        .Select(t => new MileageReading(t.TestDate, t.OdometerMiles)));
            }
            else
            {
                error = "No MOT test records were returned.";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string NormaliseRegistration(string input) =>
        new string(input.Trim().ToUpperInvariant().Where(c => !char.IsWhiteSpace(c)).ToArray());

    public class MotTest
    {
        public DateTime TestDate { get; set; }
        public string TestResult { get; set; } = "";
        public DateTime? ExpiryDate { get; set; }
        public string OdometerValue { get; set; } = "";
        public string OdometerUnit { get; set; } = "";
        public List<string> Failures { get; set; } = new();
        public List<string> Advisories { get; set; } = new();

        /// <summary>Odometer reading normalised to miles, or 0 when unreadable.</summary>
        public double OdometerMiles
        {
            get
            {
                if (!double.TryParse(OdometerValue, out var m) || m <= 0) return 0;
                return string.Equals(OdometerUnit, "km", StringComparison.OrdinalIgnoreCase)
                    ? m * 0.621371
                    : m;
            }
        }
    }
}
