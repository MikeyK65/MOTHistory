<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- Exclude the MAUI project subtree from this project's implicit compile globs -->
  <ItemGroup>
    <Compile Remove="MOTHistory.Maui\**" />
    <Content Remove="MOTHistory.Maui\**" />
    <EmbeddedResource Remove="MOTHistory.Maui\**" />
    <None Remove="MOTHistory.Maui\**" />
  </ItemGroup>

</Project>
