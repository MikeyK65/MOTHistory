<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MOTHistory.Maui.Models"
             x:Class="MOTHistory.Maui.Pages.SearchPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Hero header ── -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource PrimaryColor}">
            <Grid.Padding>
                <OnPlatform x:TypeArguments="Thickness">
                    <On Platform="iOS" Value="24,60,24,24" />
                    <On Platform="Android" Value="24,40,24,24" />
                </OnPlatform>
            </Grid.Padding>
            <VerticalStackLayout Spacing="4">
                <Label Text="MOT History"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="White" />
                <Label Text="UK vehicle MOT test records"
                       FontSize="15"
                       TextColor="#FFFFFFCC" />
            </VerticalStackLayout>
        </Grid>

        <!-- ── Main scroll area ── -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,*">

            <!-- Search card -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="16,16,16,0">
                <VerticalStackLayout Spacing="10" Padding="16">
                    <Label Text="Vehicle Registration" Style="{StaticResource FormLabel}" />

                    <!-- UK plate-styled entry wrapped in a rounded border -->
                    <Border BackgroundColor="#FFFDE7"
                            StrokeThickness="1.5"
                            Stroke="{StaticResource InputBorderColor}"
                            StrokeShape="RoundRectangle 10">
                        <Entry x:Name="RegistrationEntry"
                               Style="{StaticResource PlateEntry}"
                               Placeholder="e.g. AB12 CDE"
                               ReturnType="Search"
                               Completed="OnRegistrationCompleted" />
                    </Border>

                    <Button x:Name="SearchButton"
                            Text="Check History"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnSearchClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Loading indicator -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               Grid.Row="1"
                               IsRunning="False"
                               IsVisible="False"
                               Color="{StaticResource PrimaryColor}"
                               HeightRequest="44"
                               Margin="0,16,0,0" />

            <!-- Error banner -->
            <Border x:Name="ErrorBorder"
                    Grid.Row="2"
                    Style="{StaticResource ErrorBorder}"
                    IsVisible="False"
                    Margin="16,12,16,0">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="⚠" FontSize="16" TextColor="{StaticResource FailColor}" VerticalOptions="Center" />
                    <Label x:Name="ErrorLabel"
                           FontSize="14"
                           TextColor="{StaticResource FailColor}"
                           LineBreakMode="WordWrap"
                           HorizontalOptions="Fill" />
                </HorizontalStackLayout>
            </Border>

            <!-- Results header -->
            <Label x:Name="ResultsHeaderLabel"
                   Grid.Row="3"
                   IsVisible="False"
                   Margin="20,16,20,4"
                   Style="{StaticResource SectionHeader}" />

            <!-- Empty state -->
            <VerticalStackLayout x:Name="EmptyStateLayout"
                                 Grid.Row="4"
                                 IsVisible="False"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12"
                                 Margin="40,0">
                <Label Text="🔍"
                       FontSize="48"
                       HorizontalTextAlignment="Center" />
                <Label Text="No MOT tests found for this vehicle."
                       FontSize="16"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <!-- Results list -->
            <CollectionView x:Name="ResultsView"
                            Grid.Row="4"
                            IsVisible="False"
                            SelectionMode="None"
                            ItemsUpdatingScrollMode="KeepItemsInView">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MotTest">
                        <Border Style="{StaticResource CardBorder}" Margin="16,6">
                            <VerticalStackLayout Spacing="0" Padding="16">

                                <!-- Date + badge row -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0"
                                           Text="{Binding TestDate, StringFormat='{0:d MMM yyyy}'}"
                                           Style="{StaticResource TitleLabel}"
                                           VerticalOptions="Center" />
                                    <Border Grid.Column="1"
                                            Padding="10,5"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            VerticalOptions="Center">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsPassed}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource PassColor}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsPassed}" Value="False">
                                                <Setter Property="BackgroundColor" Value="{StaticResource FailColor}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding TestResult}"
                                               TextColor="White"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </Border>
                                </Grid>

                                <!-- Odometer + expiry -->
                                <Label Text="{Binding OdometerDisplay}"
                                       Style="{StaticResource SecondaryLabel}"
                                       Margin="0,6,0,0"
                                       IsVisible="{Binding HasOdometer}" />

                                <Label Text="{Binding ExpiryDisplay}"
                                       Style="{StaticResource SecondaryLabel}"
                                       Margin="0,2,0,0"
                                       IsVisible="{Binding HasExpiry}" />

                                <!-- Separator before defects -->
                                <BoxView HeightRequest="1"
                                         BackgroundColor="{StaticResource SeparatorColor}"
                                         Margin="0,12,0,10"
                                         IsVisible="{Binding HasDefects}" />

                                <!-- Failures section -->
                                <VerticalStackLayout IsVisible="{Binding HasFailures}" Spacing="6" Margin="0,0,0,8">
                                    <Border BackgroundColor="{StaticResource FailBackgroundColor}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="10,8">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="Failures"
                                                   Style="{StaticResource DefectHeading}"
                                                   TextColor="{StaticResource FailColor}" />
                                            <StackLayout BindableLayout.ItemsSource="{Binding Failures}" Spacing="3">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <HorizontalStackLayout Spacing="6">
                                                            <Label Text="•" TextColor="{StaticResource FailColor}" FontSize="13" />
                                                            <Label Text="{Binding .}"
                                                                   Style="{StaticResource DefectItem}"
                                                                   HorizontalOptions="Fill" />
                                                        </HorizontalStackLayout>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </StackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Advisories section -->
                                <VerticalStackLayout IsVisible="{Binding HasAdvisories}" Spacing="6">
                                    <Border BackgroundColor="{StaticResource AdvisoryBackgroundColor}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="10,8">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="Advisories"
                                                   Style="{StaticResource DefectHeading}"
                                                   TextColor="{StaticResource AdvisoryColor}" />
                                            <StackLayout BindableLayout.ItemsSource="{Binding Advisories}" Spacing="3">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <HorizontalStackLayout Spacing="6">
                                                            <Label Text="•" TextColor="{StaticResource AdvisoryColor}" FontSize="13" />
                                                            <Label Text="{Binding .}"
                                                                   Style="{StaticResource DefectItem}"
                                                                   HorizontalOptions="Fill" />
                                                        </HorizontalStackLayout>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </StackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- No defects -->
                                <Label Text="✓  No defects recorded"
                                       TextColor="{StaticResource PassColor}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       Margin="0,8,0,0"
                                       IsVisible="{Binding HasNoDefects}" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <BoxView HeightRequest="24" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>

        </Grid>
    </Grid>

</ContentPage>
