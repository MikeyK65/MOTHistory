<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MOTHistory.Maui.Pages.MotTestDetailPage"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Done" Clicked="OnDoneClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,40" Spacing="12">

            <!-- Result banner -->
            <Border x:Name="ResultBanner"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    Padding="20,16">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="ResultLabel"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="DateLabel"
                           FontSize="16"
                           TextColor="White"
                           Opacity="0.9"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Vehicle stats card -->
            <Border Style="{StaticResource CardBorder}" Padding="16">
                <VerticalStackLayout Spacing="10">

                    <Grid x:Name="MileageRow" ColumnDefinitions="*,*" IsVisible="False">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="MILEAGE" Style="{StaticResource FormLabel}" />
                            <Label x:Name="MileageLabel" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="EXPIRES" Style="{StaticResource FormLabel}" />
                            <Label x:Name="ExpiryLabel" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid x:Name="ExpiryOnlyRow" ColumnDefinitions="*" IsVisible="False">
                        <VerticalStackLayout>
                            <Label Text="MOT EXPIRES" Style="{StaticResource FormLabel}" />
                            <Label x:Name="ExpiryOnlyLabel" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid x:Name="MileageOnlyRow" ColumnDefinitions="*" IsVisible="False">
                        <VerticalStackLayout>
                            <Label Text="MILEAGE" Style="{StaticResource FormLabel}" />
                            <Label x:Name="MileageOnlyLabel" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label x:Name="NoDefectsLabel"
                           Text="No defects recorded"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PassColor}"
                           IsVisible="False" />

                </VerticalStackLayout>
            </Border>

            <!-- Failures card -->
            <Border x:Name="FailuresCard"
                    IsVisible="False"
                    BackgroundColor="{StaticResource FailBackgroundColor}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="FAILURES"
                           Style="{StaticResource FormLabel}"
                           TextColor="{StaticResource FailColor}" />
                    <VerticalStackLayout x:Name="FailuresList" Spacing="10" />
                </VerticalStackLayout>
            </Border>

            <!-- Advisories card -->
            <Border x:Name="AdvisoriesCard"
                    IsVisible="False"
                    BackgroundColor="{StaticResource AdvisoryBackgroundColor}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="ADVISORIES"
                           Style="{StaticResource FormLabel}"
                           TextColor="{StaticResource AdvisoryColor}" />
                    <VerticalStackLayout x:Name="AdvisoriesList" Spacing="10" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
