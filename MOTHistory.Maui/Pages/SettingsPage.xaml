<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MOTHistory.Maui.Pages.SettingsPage"
             Title="API Settings"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Enter your DVSA API credentials. These are stored on this device and never shared."
                   FontSize="14"
                   TextColor="{StaticResource TextSecondary}"
                   LineBreakMode="WordWrap"
                   Margin="0,4,0,4" />

            <!-- Credentials card -->
            <Border StrokeShape="RoundRectangle 14"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource SurfaceColor}"
                    Padding="16">
                <VerticalStackLayout Spacing="14">

                    <Label Text="API Key" Style="{StaticResource FormLabel}" />
                    <Entry x:Name="ApiKeyEntry"
                           IsPassword="True"
                           Placeholder="Your DVSA API key"
                           Style="{StaticResource StandardEntry}" />

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource SeparatorColor}" Margin="0,2" />

                    <Label Text="Client ID" Style="{StaticResource FormLabel}" />
                    <Entry x:Name="ClientIdEntry"
                           Placeholder="OAuth Client ID"
                           Style="{StaticResource StandardEntry}" />

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource SeparatorColor}" Margin="0,2" />

                    <Label Text="Client Secret" Style="{StaticResource FormLabel}" />
                    <Entry x:Name="ClientSecretEntry"
                           IsPassword="True"
                           Placeholder="OAuth Client Secret"
                           Style="{StaticResource StandardEntry}" />

                </VerticalStackLayout>
            </Border>

            <!-- Endpoints card -->
            <Border StrokeShape="RoundRectangle 14"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource SurfaceColor}"
                    Padding="16">
                <VerticalStackLayout Spacing="14">

                    <Label Text="Base URL" Style="{StaticResource FormLabel}" />
                    <Entry x:Name="BaseUrlEntry"
                           Placeholder="https://history.mot.api.gov.uk"
                           Keyboard="Url"
                           Style="{StaticResource StandardEntry}" />

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource SeparatorColor}" Margin="0,2" />

                    <Label Text="Scope URL" Style="{StaticResource FormLabel}" />
                    <Entry x:Name="ScopeUrlEntry"
                           Placeholder="https://tapi.dvsa.gov.uk/.default"
                           Keyboard="Url"
                           Style="{StaticResource StandardEntry}" />

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource SeparatorColor}" Margin="0,2" />

                    <Label Text="Token URL" Style="{StaticResource FormLabel}" />
                    <Entry x:Name="TokenUrlEntry"
                           Placeholder="https://login.microsoftonline.com/{tenant}/oauth2/v2.0/token"
                           Keyboard="Url"
                           Style="{StaticResource StandardEntry}" />

                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <Button Text="Save Settings"
                    Clicked="OnSaveClicked"
                    Style="{StaticResource PrimaryButton}" />

            <Button Text="Clear All Credentials"
                    Clicked="OnClearClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource FailColor}"
                    BorderColor="{StaticResource FailColor}"
                    BorderWidth="1.5"
                    CornerRadius="12"
                    HeightRequest="50"
                    FontSize="17"
                    HorizontalOptions="Fill" />

            <!-- Status message -->
            <Label x:Name="StatusLabel"
                   IsVisible="False"
                   HorizontalTextAlignment="Center"
                   FontSize="14"
                   Margin="0,4" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
