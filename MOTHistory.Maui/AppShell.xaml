<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:MOTHistory.Maui.Pages"
       x:Class="MOTHistory.Maui.AppShell"
       Shell.TabBarBackgroundColor="{StaticResource SurfaceColor}"
       Shell.TabBarForegroundColor="{StaticResource PrimaryColor}"
       Shell.TabBarTitleColor="{StaticResource PrimaryColor}"
       Shell.TabBarUnselectedColor="{StaticResource PlaceholderColor}">

    <TabBar>
        <ShellContent
            Title="Search"
            ContentTemplate="{DataTemplate pages:SearchPage}"
            Route="SearchPage" />

        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate pages:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>

</Shell>
